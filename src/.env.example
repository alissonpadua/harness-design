# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=Boilerplate
APP_ENV=local
APP_KEY=                                  # generated by harness/init.sh
APP_DEBUG=true
APP_URL=http://localhost:8080             # nginx container host port

# Locale/timezone defaults (per-user override lives on users table — M8)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC                          # API always emits UTC; tz is a display concern

# Set false in prod to hide /docs (public JSON/OpenAPI docs endpoint)
DOCS_PUBLIC=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (docker compose service: pgsql — host port 5433) ──────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql                             # container DNS; use 127.0.0.1:5433 from host tools
DB_PORT=5432
DB_DATABASE=boilerplate
DB_USERNAME=boilerplate
DB_PASSWORD=secret

# ─── Sessions / cache / queue / broadcast (redis + reverb services) ─────────
SESSION_DRIVER=database                   # DB-backed → enables token/device management (M1)
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log              # switch to reverb when laravel/reverb lands (spec 004)

REDIS_CLIENT=phpredis
REDIS_HOST=redis                          # container DNS
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_HOST=reverb                        # container DNS for server-side publishing
REVERB_PORT=8080
REVERB_APP_ID=boilerplate
REVERB_APP_KEY=bo-key
REVERB_APP_SECRET=bo-secret

# ─── Mail (mailpit service — UI at http://localhost:8025) ───────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit                         # container DNS; host: 127.0.0.1:1025
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@boilerplate.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Object storage (rustfs service, S3-compatible — console :9001) ─────────
AWS_ACCESS_KEY_ID=boilerplate
AWS_SECRET_ACCESS_KEY=boilerplate-dev
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=private-assets
AWS_ENDPOINT=http://rustfs:9000           # container DNS; host: http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Social login (spec 001 — set at least one; redirect/exchange 501-free only with creds) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/.auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/.auth/facebook/callback"

# ─── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
WEBAUTHN_USERLESS=true                  # discoverable credentials (login without email)

# ─── Billing (Stripe — real values in prod; tests always use FakeGateway) ───
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Billing (spec 003)
BILLING_DRIVER=stripe
BILLING_FAKE_WEBHOOK_SECRET=
BILLING_TAX_ENABLED=false
BILLING_DUNNING_GRACE_DAYS=7
BILLING_OVER_LIMIT_GRACE_DAYS=30
BILLING_CHECKOUT_SUCCESS_URL=
BILLING_CHECKOUT_CANCEL_URL=

# ─── Frontend build (unused until an admin SPA exists) ──────────────────────
VITE_APP_NAME="${APP_NAME}"
